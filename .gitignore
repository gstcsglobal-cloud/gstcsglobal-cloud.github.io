# 이 저장소는 GitHub Pages라 공개다. 실제 운영 데이터가 절대 올라가면 안 된다.
# 검증용 픽스처에는 작업자 실명·고객사·설비호기가 들어 있다 —
# 각자 로컬에서 만들어 쓰고, 저장소에는 만드는 방법(tests/README.md)만 둔다.
tests/*.csv
tests/hdr*.json
tests/local-hashes.json
tests/sw-extract.ts
tests/sync-extract.ts
tests/bot-extract.ts
*.xlsx
*.xls

# 의존성 · 산출물
# 슬래시 없는 형태도 함께 막는다 — 심볼릭 링크는 디렉터리 규칙(node_modules/)에 걸리지 않는다
tests/node_modules
tests/node_modules/
node_modules
node_modules/
tests/screenshots/
*.zip
*.bundle

# OS
.DS_Store
Thumbs.db

# 분석 도구가 만드는 산출물 — 소스가 아니다
*.decls.json

# 이행 전 KPI 스냅샷 — 실데이터 기반이라 커밋하지 않는다
.snap.json

# 숏폼 제작 산출물 — 폰트·프레임·중간 파일은 로컬에서 만든다(shortform/README.md)
shortform/fonts/
shortform/frames*/
shortform/bgm.wav
shortform/bgm-*.wav
shortform/video_only.mp4
# 인물 사진은 공개 저장소에 올리지 않는다(얼굴 사진)
shortform/portraits/
shortform/spot*/
shortform/prev/
shortform/chk/
shortform/fchk/
shortform/e2/
shortform/e3/
shortform/mb*/
shortform/*.png
shortform/chk2/
# 3D 컷어웨이 — three.js 는 npm 으로 받고(3d/README), 프레임은 중간 산출물이다
shortform/3d/node_modules/
shortform/3d/f3d*/
shortform/3d/probe*/
# 제품 실물 사진 텍스처 — «반입 가부를 확인받기 전까지» 올리지 않는다.
#   도열 씬(s7.html)의 설비는 GAIA 실물 사진을 판에 붙인 2.5D 빌보드다. 제품 마케팅
#   이미지로 보이지만 이 저장소는 공개이므로, 확인 없이 올리면 되돌릴 수 없다(지워도 이력에 남는다).
#   ⚠ 이 파일이 없으면 설비가 흰 판으로 렌더된다 — 그때는 ?bb=0 으로 순수 3D 경로를 쓴다.
#   승인이 나면 이 줄을 지우고 커밋한다.
shortform/3d/tex/
shortform/cframes/
shortform/_cv.mp4
# 구간 확인용 클립 — 검토가 끝나면 버린다(최종본만 저장소에 둔다)
shortform/s6_new.mp4
shortform/clip.mp4
shortform/chk_*.mp4
# 실사 원본(마스터) — 업스케일·그레이딩 «전»의 큰 파일은 저장소에 두지 않는다.
# 렌더에 실제로 쓰이는 것은 webm 쪽이고 그건 커밋한다(없으면 아무도 렌더를 못 한다)
shortform/footage/*.mp4
